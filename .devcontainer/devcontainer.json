{
  "name": "Trade Lab",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8001],
  "portsAttributes": {
    "8001": {
      "label": "Trade Lab",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
