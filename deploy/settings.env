# Non-secret deployment settings. Edit this file when changing the Render service or image.
GHCR_IMAGE=ghcr.io/anigov/trade
RENDER_DEFAULT_IMAGE_TAG=latest
RENDER_SERVICE_NAME=trade-app
RENDER_SERVICE_ID=
RENDER_OWNER_ID=
RENDER_REGION=oregon
RENDER_PLAN=starter
RENDER_PORT=10000
RENDER_HEALTH_CHECK_PATH=/api/health
RENDER_DEPLOY_HOOK_SECRET_NAME=RENDER_DEPLOY_HOOK_URL
NEON_PROJECT_NAME=trade-prod
NEON_PROJECT_ID=
NEON_BRANCH_NAME=main
NEON_DATABASE_NAME=neondb
NEON_REGION=
NEON_DATABASE_SECRET_NAME=DATABASE_URL
COOKIE_SECURE=true
SESSION_TTL_SECONDS=28800
SEED_DEMO_DATA=false
